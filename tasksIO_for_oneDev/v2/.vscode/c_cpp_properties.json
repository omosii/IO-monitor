{
  "version": 4,
  "configurations": [
    {
      "name": "Linux",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64",
      "browse": {
        "path": [
          "${workspaceFolder}",
          "/usr/src/linux-headers-6.8.0-65-generic/include",
          "/usr/src/linux-headers-6.8.0-65-generic/arch/x86/include",
          "/usr/src/linux-headers-6.8.0-65-generic"
        ],
        "limitSymbolsToIncludedHeaders": true
