      "includePath": [
        "${workspaceFolder}/**",
        "/usr/src/linux-headers-6.8.0-65-generic/include",
        "/usr/src/linux-headers-6.8.0-65-generic/arch/x86/include",
        "/usr/src/linux-headers-6.8.0-65-generic/arch/x86/include/generated",
        "/usr/src/linux-headers-6.8.0-65-generic/include/linux",
        "/usr/src/linux-headers-6.8.0-65-generic/include/uapi",
        "/usr/src/linux-headers-6.8.0-65-generic/include/generated/uapi",
        "/usr/src/linux-headers-6.8.0-65-generic/arch/x86/include/uapi",
        "/usr/src/linux-headers-6.8.0-65-generic/arch/x86/include/generated/uapi"
      ],
      "defines": [
